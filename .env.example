# Resend API Key — sends all lead notifications and client confirmations.
# Get from resend.com/api-keys · Add to Vercel: Settings > Environment Variables
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# OpenAI API Key — get from platform.openai.com/api-keys
# Add this to Vercel: Settings > Environment Variables > OPENAI_API_KEY
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx

# Sender address for all outgoing email. Its domain must be verified
# at resend.com/domains. Optional — defaults to noreply@bluelightning.us
RESEND_FROM=noreply@bluelightning.us

# Supabase — stores every lead so none is lost if email delivery fails.
# Both from supabase.com/dashboard > your project > Settings > API
# SERVICE ROLE KEY IS SECRET: it bypasses row level security. Server-side only,
# never prefix it with NEXT_PUBLIC_ or it will be exposed to the browser.
# Run supabase/schema.sql in the SQL Editor before the first deploy.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJxxxxxxxxxxxxxxxx

# Google Tag Manager — get this from tagmanager.google.com
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Search Console verification — get this from search.google.com/search-console
NEXT_PUBLIC_GSC_VERIFICATION=xxxxxxxxxxxxxxxxxxxx

# Production site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://bluelightning.us
